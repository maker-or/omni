DB_FILE_NAME=pipper.sqlite
OMNI_CWD=<path-to-omni>
PIPPER_POSTHOG_KEY=
PIPPER_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_ENABLED=true
# Optional one-time bridge for already installed launchers that still read the old Vercel Blob manifest.
BLOB_READ_WRITE_TOKEN=
# Morning Brief: Composio (tool connections) and TypeSafe (Jev triage) keys.
PIPPER_COMPOSIO_API_KEY=
PIPPER_TYPESAFE_API_KEY=
# Optional: Claude API key for the brief's writer (falls back to the local `claude` CLI, then built-in prose).
PIPPER_ANTHROPIC_API_KEY=
