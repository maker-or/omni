---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
const {
    title = "pipper",
    description = "pipper — self-improving agent interface",
    image = "/og.png",
    pageClass,
    hideHeader,
    hideFooter = false,
    noindex = false,
} = Astro.props;
const pagePath = Astro.url.pathname;
const site = Astro.site ?? new URL("https://www.pipper.dev");
const canonical = new URL(pagePath, site);
const ogImage = new URL(image, site).toString();
const pageName =
    pagePath === "/"
        ? "home"
        : pagePath.replace(/^\/+|\/+$/g, "").replace(/\//g, ".") || "home";
const showDownloadNavLink = pageClass !== "download-page";
const isCanvasPage = [
    "home-page",
    "download-page",
    "auth-page",
    "auth-complete-page",
    "sign-in-page",
    "sign-up-page",
].includes(pageClass);
---

<html
    lang="en"
    class:list={[
        "min-h-svh [color-scheme:light]",
        pageClass === "sandesh-page" ? "h-svh overflow-hidden" : "overflow-x-hidden",
    ]}
>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <Analytics />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Tiro+Devanagari+Hindi&family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap"
            rel="stylesheet"
        />
        <link rel="icon" href="/favicon.ico" sizes="48x48" />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex" />}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="pipper" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={title} />
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Organization",
                name: "pipper code",
                url: site.toString(),
                logo: `${site}favicon.ico`,
                description:
                    "pipper — an interface for your AI agents. Run, orchestrate, and manage multiple coding agents from one desktop app.",
                sameAs: ["https://github.com/maker-or/omni"],
            })}
        />
        <title>{title}</title>
    </head>
    <body
        class={`${pageClass} antialiased`}
        data-page={pageName}
        style:list={[
            isCanvasPage
                ? "background:#f0efed;color:#111111"
                : "background:#15408f;color:#d1e1ff",
        ]}
    >
        <div
            class:list={[
                "flex flex-col",
                pageClass === "sandesh-page" ? "h-svh overflow-hidden" : "min-h-svh",
            ]}
        >
            {
                !hideHeader && (
                    <header
                        class:list={[
                            "site-header",
                            isCanvasPage ? "site-header--canvas" : "site-header--blue",
                        ]}
                    >
                        <a href="/" class="site-logo">
                            pipper code
                        </a>
                        <nav class="site-nav" aria-label="Primary">
                            <a href="/">Home</a>
                            <a
                                href="https://discord.gg/S928NjYv"
                                target="_blank"
                                rel="noopener noreferrer">Discord</a
                            >
                            {
                                showDownloadNavLink ? (
                                    <a href="/download">Download</a>
                                ) : null
                            }
                        </nav>
                    </header>
                )
            }
            <main class="main flex-1 flex flex-col items-center w-full min-h-0">
                <slot />
            </main>
            {
                !hideFooter && (
                    <footer class="site-footer">
                        <span>© {new Date().getFullYear()} pipper code</span>
                        <nav class="site-footer-nav" aria-label="Legal">
                            <a href="/legal/terms/">Terms</a>
                            <a href="/legal/privacy/">Privacy</a>
                        </nav>
                    </footer>
                )
            }
        </div>
    </body>
</html>

<style is:global>
    .site-header {
        display: flex;
        width: min(calc(100% - 3rem), 120rem);
        margin: 0 auto;
        padding: 1.5rem 0 1rem;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        flex-shrink: 0;
    }

    .site-header--canvas { color: #111; }
    .site-header--blue { color: #d1e1ff; }

    .site-logo {
        color: currentColor;
        font-family: "Figtree Variable", sans-serif;
        font-size: clamp(1.45rem, 2.5vw, 2rem);
        font-weight: 620;
        letter-spacing: -0.055em;
        text-decoration: none;
    }

    .site-nav {
        display: flex;
        align-items: center;
        gap: clamp(1rem, 3vw, 2.8rem);
        font-family: "Figtree Variable", sans-serif;
        font-size: 0.95rem;
        font-weight: 520;
        letter-spacing: -0.025em;
    }

    .site-nav a {
        color: currentColor;
        text-decoration: none;
        transition: color 160ms ease;
    }

    .site-header--canvas .site-nav a:hover,
    .site-header--canvas .site-nav a:focus-visible { color: #2162ff; }
    .site-header--blue .site-nav a:hover,
    .site-header--blue .site-nav a:focus-visible { color: #fff; }

    .site-nav a:focus-visible,
    .site-logo:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 4px;
    }

    .site-footer {
        display: flex;
        width: min(calc(100% - 3rem), 120rem);
        margin: 0 auto;
        padding: 0.75rem 0 2rem;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        font-family: "Figtree Variable", sans-serif;
        font-size: 0.8rem;
        color: currentColor;
        opacity: 0.75;
        flex-shrink: 0;
    }

    .site-footer-nav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .site-footer-nav a {
        color: currentColor;
        text-decoration: none;
        transition: color 160ms ease;
    }

    .site-footer-nav a:hover,
    .site-footer-nav a:focus-visible {
        color: #2162ff;
    }

    .site-header--blue .site-footer-nav a:hover,
    .site-header--blue .site-footer-nav a:focus-visible {
        color: #fff;
    }

    @media (max-width: 38rem) {
        .site-footer {
            width: min(calc(100% - 2rem), 120rem);
            font-size: 0.75rem;
        }
    }

    @media (max-width: 38rem) {
        .site-header { width: min(calc(100% - 2rem), 120rem); padding-top: 1.1rem; }
        .site-nav { gap: 0.85rem; font-size: 0.82rem; }
        .site-nav a:first-child { display: none; }
    }
</style>
