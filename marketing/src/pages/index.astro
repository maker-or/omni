                                <path d="M62.0438 6.86278L80.0698 63.0558C81.8012 68.4532 76.7349 73.5628 71.323 71.8774L10.9189 53.066C4.09546 50.941 4.46801 41.16 11.4333 39.5603L36.9423 33.7015C39.3929 33.1387 41.3533 31.3047 42.0782 28.8971L48.6756 6.98303C50.6567 0.402474 59.9447 0.31892 62.0438 6.86278Z" stroke="#0C59FD" stroke-width="4"/>
