<script>
    // Start the platform download immediately, then land on /download?started=1
    // so the page can confirm it and offer a fallback link + setup steps.
    const heroDownload = document.querySelector("#hero-download");
    heroDownload?.addEventListener("click", (event) => {
        event.preventDefault();
        const isWindows = /win/i.test(navigator.userAgent);
        const manifestUrl = isWindows
            ? "/api/launcher/latest-windows.json"
            : "/api/launcher/latest.json";
        fetch(manifestUrl, { cache: "no-store" })
            .then((response) => {
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                return response.json();
            })
            .then((manifest) => {
                const url = new URL(manifest.url, window.location.origin);
                if (url.protocol !== "https:") throw new Error("bad url");
                // Assigning location to an attachment response (.dmg/.exe)
                // downloads without unloading the page — most reliable
                // cross-browser trigger (anchor+download is ignored
                // cross-origin and can be swallowed).
                window.location.href = url.toString();
                window.setTimeout(() => {
                    window.location.href = "/download?started=1";
                }, 1200);
            })
            .catch(() => {
                // No file to start — land without the started flag so the
                // page doesn't claim a download began.
                window.location.href = "/download";
            });
    });
</script>

<style>
    :global(.home-page) {
        --canvas-bg: #f0efed;
        --canvas-ink: #111111;
        --canvas-blue: #2162ff;
        --canvas-blue-soft: #d8e5ff;
        --canvas-orange: #ffa946;
        --canvas-orange-ink: #a65b0e;
        --canvas-purple: #a54cf1;
        --canvas-purple-soft: #e8d9fa;
        --canvas-muted: #6e6e6e;
        background: var(--canvas-bg) !important;
        color: var(--canvas-ink) !important;
    }

    .home-shell {
        position: relative;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        width: 100%;
        min-height: 100svh;
        margin: 0;
        border: none;
        overflow: hidden;
        isolation: isolate;
    }

    .hero-demo {
        width: 100%;
        max-width: 96rem;
        margin: 0.5rem auto 0;
    }
    .hero-demo > section {
        height: min(160svh, 92rem) !important;
        width: 100% !important;
        padding: 0 !important;
        background: transparent !important;
    }

    .agents-section {
        box-sizing: border-box;
        width: 100vw;
        min-height: 100svh;
        padding: clamp(1.15rem, 3vw, 3.75rem);
        background: var(--canvas-bg);
    }

    .agents-board {
        box-sizing: border-box;
        min-height: calc(100svh - clamp(2.3rem, 6vw, 7.5rem));
        padding: clamp(4rem, 10.5vh, 8rem) clamp(2rem, 6.5vw, 8rem)
            clamp(2.5rem, 5vw, 5rem);
        border: none;
        overflow: hidden;
    }

    .agents-layout {
        display: grid;
        grid-template-columns: minmax(20rem, 0.88fr) minmax(38rem, 1.28fr);
        align-items: center;
        gap: clamp(2rem, 5.2vw, 7rem);
        min-height: calc(100svh - clamp(11rem, 21vw, 19rem));
    }

    .agents-copy {
        align-self: start;
    }

    .agents-title {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.2em;
        margin: 0;
        color: #565656;
        font-family: "Figtree Variable", sans-serif;
        font-size: clamp(3rem, 4.2vw, 5rem);
        font-weight: 420;
        line-height: 0.94;
        letter-spacing: -0.09em;
    }

    .agents-title__accent {
        color: #b66509;
        font-weight: 520;
    }

    .agent-list {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: clamp(0.72rem, 1.55vh, 1.25rem);
        margin: clamp(2.4rem, 4.4vh, 4rem) 0 0;
        padding: 0;
        list-style: none;
    }

    .agent-chip {
        display: flex;
        align-items: center;
        box-sizing: border-box;
        min-width: clamp(14.5rem, 15vw, 19rem);
        padding: clamp(0.7rem, 1.25vw, 1.2rem) clamp(1.35rem, 2vw, 2.25rem)
            clamp(0.82rem, 1.45vw, 1.35rem);
        border-radius: 999px;
        background: #ffad4b;
        color: #a95c09;
        font-family: "Figtree Variable", sans-serif;
        font-size: clamp(2.35rem, 3.65vw, 4.25rem);
        font-weight: 420;
        line-height: 0.84;
        letter-spacing: -0.095em;
        white-space: nowrap;
    }

    .agent-chip--claude {
        min-width: clamp(17rem, 17.5vw, 22rem);
    }
    .agent-chip--codex {
        min-width: clamp(16rem, 16.8vw, 21rem);
    }
    .agent-chip--copilot {
        min-width: clamp(17rem, 17.5vw, 22rem);
    }
    .agent-chip--cursor {
        min-width: clamp(16.5rem, 17vw, 21.5rem);
    }
    .agent-chip--opencode {
        min-width: clamp(20rem, 22vw, 28rem);
    }

    .agent-matrix {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: clamp(1.25rem, 3.2vw, 3.75rem) clamp(1rem, 3vw, 3.75rem);
        width: min(100%, 58rem);
        justify-self: end;
    }

    .agent-tile {
        position: relative;
        display: grid;
        aspect-ratio: 1;
        place-items: center;
        border-radius: 1.08rem;
    }

    .agent-tile--0 {
        background: #27b45c;
    }
    .agent-tile--1 {
        background: #ffb24f;
    }
    .agent-tile--2 {
        background: #86aff1;
    }
    .agent-tile--3 {
        background: #b247ee;
    }

    .agent-glyph {
        position: relative;
        display: block;
        width: 72%;
        height: auto;
        max-height: 76%;
    }

    .feature-section {
        box-sizing: border-box;
        width: 100vw;
        min-height: 100svh;
        padding: clamp(1.15rem, 3vw, 3.75rem);
        background: var(--canvas-bg);
    }

    .feature-board {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(5rem, 10vw, 13rem);
        box-sizing: border-box;
        min-height: calc(100svh - clamp(2.3rem, 6vw, 7.5rem));
        padding: clamp(3.1rem, 4.7vw, 5rem) clamp(2rem, 5.6vw, 6.8rem)
            clamp(2.5rem, 5vw, 5rem);
        border: 1.5px solid var(--canvas-ink);
        overflow: hidden;
    }

    .feature-board,
    .feature-column {
        isolation: isolate;
    }

    .feature-column {
        position: relative;
        min-height: calc(100svh - clamp(8rem, 14vw, 13rem));
    }

    .feature-column--subagents {
        text-align: right;
    }

    .feature-title,
    .feature-description {
        position: relative;
        z-index: 2;
        margin: 0;
        color: #565656;
        font-family: "Figtree Variable", sans-serif;
        letter-spacing: -0.095em;
    }

    .feature-title {
        color: #272727;
        font-size: clamp(3.4rem, 4.55vw, 5.6rem);
        font-weight: 500;
        line-height: 0.9;
