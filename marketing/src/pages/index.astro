---
import Layout from "../layouts/Layout.astro";
import ProductDemo from "../components/ProductDemo.tsx";
---

<Layout
    title="pipper — an interface for your agents"
    description="pipper is the interface for building, directing, and improving AI agents."
    pageClass="home-page"
    hideHeader
>
    <div class="home-shell">
        <main class="home-content">
            <section class="hero-block" aria-labelledby="hero-title">
                <h1 id="hero-title" class="hero-title">
                    <span class="hero-cursor hero-cursor--blue" aria-hidden="true">
                        <svg width="87" height="83" viewBox="0 0 87 83" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <g filter="url(#heroCursorBlue)">
