---
import Layout from "../layouts/Layout.astro";

const macLauncherManifestUrl = "/api/launcher/latest.json";
const windowsLauncherManifestUrl = "/api/launcher/latest-windows.json";
---

<Layout
    title="Download pipper code for macOS & Windows"
    description="Download pipper code for macOS and Windows."
    pageClass="download-page"
>
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            name: "Pipper Code",
            applicationCategory: "DeveloperApplication",
            operatingSystem: "macOS, Windows",
            url: "https://www.pipper.dev/download",
            downloadUrl: "https://www.pipper.dev/download",
            sameAs: "https://github.com/maker-or/omni",
            description:
                "Pipper Code is a free desktop app for running multiple AI coding agents — Claude Code, Codex, Cursor, OpenCode, Copilot, Grok — from one interface.",
            offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "USD",
            },
        })}
    ></script>
    <div class="download-shell">
        <main class="download-content">
            <section class="hero-block" aria-labelledby="download-title">
                <h1 id="download-title" class="hero-title">
                    <span class="hero-title__blue">Download</span>
                    <span class="hero-pill">@pipper</span>
                </h1>

                <p
                    id="started-note"
                    class="started-note"
                    style="display:none"
                    aria-live="polite"
                >
                    Your download has already started.
                    <span>
                        {" "}
                        If it didn&apos;t,{" "}
                        <a id="started-retry" href="#">
                            click here
                        </a>{" "}
                    </span>
                </p>
            </section>

            <section class="download-board" aria-label="Download options">
                <aside
                    id="launch-note"
                    class="setup-card"
                    aria-label="Unsigned macOS and Windows launch notes"
                >
                    <div id="mac-launch-note">
                        <p class="setup-title">follow these steps</p>
                        <ol class="setup-steps">
                            <li>
                                <svg class="setup-num" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8.7 25.1 39.2 9.8c2.8-1.4 5.8 1.2 4.8 4.2l-9.5 30.1c-.9 2.8-4.8 3.1-6.1.5l-6.4-12.8-12.6-1.6c-3-.4-3.5-3.9-.7-5.1Z" fill="#FFAA4F" stroke="#B1620D" stroke-width="3"/></svg>
                                <span>
                                    Your download should have <strong>started automatically</strong>.
                                </span>
                            </li>
                            <li>
                                <svg class="setup-num" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8.7 25.1 39.2 9.8c2.8-1.4 5.8 1.2 4.8 4.2l-9.5 30.1c-.9 2.8-4.8 3.1-6.1.5l-6.4-12.8-12.6-1.6c-3-.4-3.5-3.9-.7-5.1Z" fill="#FFAA4F" stroke="#B1620D" stroke-width="3"/></svg>
                                <span>
                                    <strong>Move</strong> Pipper Code
                                    (Alpha).app to Applications.
                                </span>
                            </li>
                            <li>
                                <svg class="setup-num" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8.7 25.1 39.2 9.8c2.8-1.4 5.8 1.2 4.8 4.2l-9.5 30.1c-.9 2.8-4.8 3.1-6.1.5l-6.4-12.8-12.6-1.6c-3-.4-3.5-3.9-.7-5.1Z" fill="#FFAA4F" stroke="#B1620D" stroke-width="3"/></svg>
                                <span>
                                    <strong>Open</strong> Terminal.
                                </span>
                            </li>
                            <li>
                                <svg class="setup-num" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8.7 25.1 39.2 9.8c2.8-1.4 5.8 1.2 4.8 4.2l-9.5 30.1c-.9 2.8-4.8 3.1-6.1.5l-6.4-12.8-12.6-1.6c-3-.4-3.5-3.9-.7-5.1Z" fill="#FFAA4F" stroke="#B1620D" stroke-width="3"/></svg>
                                <span>
                                    <strong>
                                        Run this command (before opening the
                                        app):
                                    </strong>
                                </span>
                            </li>
                        </ol>
                        <code class="setup-code">
                            xattr -cr "/Applications/Pipper Code (Alpha).app"
                        </code>
                    </div>
                    <div
                        id="windows-launch-note"
                        style="display: none !important;"
                    >
                        <strong>Windows note:</strong> This build is unsigned.
                        If SmartScreen warns you, choose{" "}
                        <strong>More info</strong> and then
                        <strong>Run anyway</strong>, or right-click the
                        installer and choose
                        <strong>Run as administrator</strong> if installation is
                        blocked.
                    </div>
                </aside>
            </section>
        </main>
    </div>
</Layout>

<style>
    :global(.download-page) {
        --canvas-bg: #f0efed;
        --canvas-ink: #111111;
        --canvas-blue: #2162ff;
        --canvas-blue-soft: #d8e5ff;
        --canvas-orange: #ffa946;
        --canvas-orange-ink: #a65b0e;
        --canvas-purple: #a54cf1;
        --canvas-purple-soft: #e8d9fa;
        --canvas-green: #088139;
        --canvas-green-soft: #26b25a;
        --canvas-muted: #6e6e6e;
        background: var(--canvas-bg) !important;
        color: var(--canvas-ink) !important;
    }

    .download-shell {
        box-sizing: border-box;
        width: 100%;
        min-height: 100svh;
        margin: 0;
        overflow: hidden;
        isolation: isolate;
        background: var(--canvas-bg);
    }

    .download-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        margin: 0 auto;
        padding: clamp(3.25rem, 5.2vw, 5rem) clamp(2rem, 5vw, 6.5rem) 4rem;
        font-family: "Figtree Variable", sans-serif;
    }

    .hero-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: min(100%, 80rem);
        text-align: center;
    }

    .hero-title {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
        column-gap: 0.3em;
        margin: 0;
        font-family: "Figtree Variable", sans-serif;
        font-size: clamp(2.6rem, 5.2vw, 5rem);
        font-weight: 420;
        line-height: 1;
        letter-spacing: -0.078em;
        animation: rise-in 850ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero-title__blue {
        color: var(--canvas-blue);
    }

    .hero-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.08em 0.32em 0.13em;
        border-radius: 999px;
        background: var(--canvas-orange);
        color: var(--canvas-orange-ink);
        letter-spacing: -0.085em;
        transform: translateY(-0.03em) rotate(-0.7deg);
    }

    .hero-sub {
        margin: 1.5rem 0 0;
        color: var(--canvas-muted);
        font-size: clamp(1.05rem, 1.5vw, 1.4rem);
        font-weight: 420;
        letter-spacing: -0.045em;
        animation: rise-in 850ms 180ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .version-label {
        color: var(--canvas-ink);
    }
    .changelog-link {
        color: var(--canvas-muted);
        text-decoration: none;
    }
    .changelog-link:hover {
        color: var(--canvas-ink);
    }
    .hero-sub a {
        color: inherit;
    }

    .started-note {
        margin: 1.5rem 0 0;
        padding: 0.65rem 1.1rem;
        border-radius: 999px;
        background: var(--canvas-blue-soft);
        color: var(--canvas-blue);
        font-size: 1rem;
        letter-spacing: -0.02em;
    }
    .started-note a {
        color: var(--canvas-orange-ink);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 2px;
    }
    .started-note a:hover {
        color: var(--canvas-ink);
    }

    .download-board {
        box-sizing: border-box;
        width: min(100%, 56rem);
        margin-top: clamp(2.5rem, 4vw, 4rem);
        padding: clamp(2.5rem, 4vw, 4rem);
        border: 1.5px solid var(--canvas-ink);
        animation: rise-in 850ms 250ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .setup-card {
        min-width: 0;
    }

    .setup-title {
        margin: 0 0 1.2rem;
        color: #272727;
        font-size: clamp(1.8rem, 2.6vw, 2.6rem);
        font-weight: 500;
        line-height: 0.95;
        letter-spacing: -0.09em;
    }

    .setup-steps {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        margin: 0;
        padding: 0;
    }
    .setup-steps li {
        display: inline-flex;
        align-items: baseline;
        gap: 0.6rem;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
    }
    .setup-steps strong {
        color: var(--canvas-blue);
        font-weight: 560;
    }
    .setup-num {
        width: 1.1em;
        height: 1.1em;
        flex-shrink: 0;
        align-self: center;
        overflow: visible;
    }
    .setup-code {
        display: block;
        margin-top: 1rem;
        padding: 0.7rem 0.9rem;
        border-radius: 0.65rem;
        background: var(--canvas-blue-soft);
        color: var(--canvas-blue);
        font-size: 0.9rem;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    #windows-launch-note {
        display: none !important;
    }

    @keyframes rise-in {
        from {
            opacity: 0;
            transform: translateY(1rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 58rem) {
        .download-content {
            padding: 3.25rem 1.7rem 3.5rem;
        }
        .download-board {
            padding: 2rem 1.2rem;
        }
        .hero-title {
            font-size: clamp(2.45rem, 11.8vw, 4rem);
            line-height: 0.94;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-title,
        .hero-sub,
        .download-board {
            animation: none;
        }
    }
</style>

<script define:vars={{ macLauncherManifestUrl, windowsLauncherManifestUrl }}>
    const versionLabel = document.querySelector("#version-label");
    const startedNote = document.querySelector("#started-note");
    const startedRetry = document.querySelector("#started-retry");
    const macLaunchNote = document.querySelector("#mac-launch-note");
    const windowsLaunchNote = document.querySelector("#windows-launch-note");
    const semver =
        /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/;

    // Resolved download URLs keyed by platform. The visible DMG/.exe buttons
    // are gone on purpose: the hero Download button already starts the file
    // before navigating here, so this page only offers the top "click here"
    // fallback link plus the setup steps.
    const downloadUrls = { mac: null, windows: null };

    function validManifest(value, extension) {
        if (!value || typeof value !== "object" || Array.isArray(value))
            return false;
        if (
            JSON.stringify(Object.keys(value).sort()) !==
            JSON.stringify(["schema_version", "sha256", "url", "version"])
        )
            return false;
        try {
            const url = new URL(value.url);
            return (
                value.schema_version === 1 &&
                semver.test(value.version) &&
                url.protocol === "https:" &&
                url.pathname.toLowerCase().endsWith(extension) &&
                /^[0-9a-fA-F]{64}$/.test(value.sha256)
            );
        } catch {
            return false;
        }
    }

    function updateVersionLabel(version) {
        if (!versionLabel) return;
        versionLabel.textContent = `· Version ${version}`;
    }

    function triggerDownload(url) {
        if (!url) return;
        const anchor = document.createElement("a");
        anchor.href = url;
        anchor.setAttribute("download", "");
        anchor.rel = "noopener";
        document.body.appendChild(anchor);
        anchor.click();
        anchor.remove();
    }

    function platformKey() {
        return /win/i.test(navigator.userAgent) ? "windows" : "mac";
    }

    async function resolveManifest({ key, manifestUrl, extension, launchNote }) {
        try {
            if (!manifestUrl) throw new Error("Manifest URL is not configured");
            const response = await fetch(manifestUrl, { cache: "no-store" });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const manifest = await response.json();
            if (!validManifest(manifest, extension))
                throw new Error("Invalid manifest");
            downloadUrls[key] = manifest.url;
            updateVersionLabel(manifest.version);
            if (launchNote) launchNote.style.display = "";
            return manifest.url;
        } catch {
            return null;
        }
    }

    startedRetry?.addEventListener("click", (event) => {
        event.preventDefault();
        triggerDownload(downloadUrls[platformKey()]);
    });

    try {
        const params = new URLSearchParams(window.location.search);
        const arrivedFromHero = params.get("started") === "1";
        if (startedNote) startedNote.style.display = "";
        const pending = [
            resolveManifest({
                key: "mac",
                manifestUrl: macLauncherManifestUrl,
                extension: ".dmg",
                launchNote: macLaunchNote,
            }),
            resolveManifest({
                key: "windows",
                manifestUrl: windowsLauncherManifestUrl,
                extension: ".exe",
                launchNote: windowsLaunchNote,
            }),
        ];
        if (!arrivedFromHero) {
            // Direct visit: the hero didn't start the file, so start it here.
            void Promise.all(pending).then(() =>
                triggerDownload(downloadUrls[platformKey()]),
            );
        }
    } catch {}
</script>
